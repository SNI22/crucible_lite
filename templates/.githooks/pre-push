#!/usr/bin/env bash
# Constitutional pre-push enforcement (CI-strict).
# Runs the same 3-check stack CI runs, via the `crucible` CLI (which uses
# crucible-core's own python — works for pipx, venv, or system pip installs).
# Catches anything pre-commit warnings or `--no-verify` would have let through.
#
# Activated by `crucible init` automatically via:
#   git config core.hooksPath .githooks

set -e

if ! command -v crucible >/dev/null 2>&1; then
    echo "✗ Pre-push blocked: 'crucible' CLI not on PATH."
    echo "  Install crucible-core, e.g.:"
    echo "    pipx install -e /path/to/crucible-core"
    echo "    # or: pip install crucible-core   (when on PyPI)"
    echo "  Then retry the push."
    exit 1
fi

# Match CI: diff against origin/main when available, otherwise default.
if git rev-parse --verify origin/main >/dev/null 2>&1; then
    crucible check --base-ref origin/main
else
    crucible check
fi
