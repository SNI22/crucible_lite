#!/usr/bin/env bash
# Constitutional pre-push enforcement (CI-strict).
# Matches what GitHub Actions runs in constitution-check.yml — Article I,
# Corpus Supremacy, and Stage Gate. Catches anything pre-commit let through
# (warnings escalate, --no-verify bypasses) before changes reach GitHub.
#
# Activated by `crucible init` automatically via:
#   git config core.hooksPath .githooks

set -e

if ! python3 -c "import crucible.checks.runner" 2>/dev/null; then
    echo "✗ Pre-push blocked: crucible-core is not installed in python3."
    echo "  Run:  pip install -r requirements.txt"
    echo "  Then retry the push. (Bypass at your own risk: git push --no-verify"
    echo "  — but GitHub CI will still enforce.)"
    exit 1
fi

# Match CI: diff against origin/main when available, otherwise default.
if git rev-parse --verify origin/main >/dev/null 2>&1; then
    python3 -m crucible.checks.runner --base-ref origin/main
else
    python3 -m crucible.checks.runner
fi
